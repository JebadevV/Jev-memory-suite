{
  "name": "jev-memory-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jev-memory": "bin/jev-memory.mjs",
    "jev-memory-codex": "bin/jev-memory-codex.mjs",
    "jev-memory-claude": "bin/jev-memory-claude.mjs",
    "jev-memory-agy": "bin/jev-memory-agy.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node scripts/test-isolated.mjs --real-uv-tools",
    "suite": "node bin/jev-memory.mjs",
    "test:e2e": "node scripts/test-isolated.mjs --test-concurrency=1 test/e2e.ts",
    "test:projects": "node scripts/test-isolated.mjs --test-concurrency=1 test/projects-e2e.ts",
    "test:semantic": "node scripts/test-isolated.mjs --test-concurrency=1 test/semantic-e2e.ts",
    "test:headroom": "node scripts/test-isolated.mjs --test-concurrency=1 --real-uv-tools test/headroom-e2e.ts",
    "test:headroom-codex": "node scripts/test-isolated.mjs --test-concurrency=1 --real-uv-tools test/headroom-codex-e2e.ts",
    "test:claude-launch": "node scripts/test-isolated.mjs --test-concurrency=1 test/claude-launch-e2e.ts",
    "test:codex-launch": "node scripts/test-isolated.mjs --test-concurrency=1 --real-uv-tools test/codex-launch-e2e.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "pnpm": "10.34.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
