{
  "name": "jev-memory-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jev-memory": "bin/jev-memory.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/*.test.ts",
    "suite": "node bin/jev-memory.mjs",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "pnpm": "10.34.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
