+import os
+from urllib.parse import urlsplit
+
+# HEADROOM_CHATGPT_CODEX_BASE_URL moves the Codex backend (HTTP, WebSocket and ChatGPT-auth passthrough) to another
+# origin and path, for example a local gateway. The scheme of the base picks the WebSocket scheme: https -> wss, http -> ws.
+DEFAULT_CHATGPT_CODEX_BASE_URL = "https://chatgpt.com/backend-api/codex"
+_base = urlsplit(os.environ.get("HEADROOM_CHATGPT_CODEX_BASE_URL", "").strip() or DEFAULT_CHATGPT_CODEX_BASE_URL)
+if _base.scheme not in ("http", "https") or not _base.hostname or _base.query or _base.fragment or _base.username or _base.password:
+    raise ValueError("HEADROOM_CHATGPT_CODEX_BASE_URL must be an http(s) URL without query, fragment or userinfo")
+
+CHATGPT_BACKEND_API_URL = f"{_base.scheme}://{_base.netloc}"
+CHATGPT_BACKEND_WS_URL = f"{'wss' if _base.scheme == 'https' else 'ws'}://{_base.netloc}"
+CODEX_BACKEND_PREFIX = _base.path.rstrip("/")
+
+
+def chatgpt_backend_origin() -> str:
+    """Return the HTTP origin that ChatGPT-auth passthrough requests are forwarded to."""
+    return CHATGPT_BACKEND_API_URL
 
 
