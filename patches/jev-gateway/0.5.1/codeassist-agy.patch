+  it("decodes a gzip reply from upstream and drops its content-encoding", async () => {
+    const payload = { response: { candidates: [], usageMetadata: { promptTokenCount: 3, candidatesTokenCount: 1 } }, traceId: "gz" };
+    const server: Server = createServer((_request, reply) => {
+      reply.writeHead(200, { "content-type": "application/json", "content-encoding": "gzip" });
+      reply.end(gzipSync(JSON.stringify(payload)));
+    });
+    await new Promise<void>((done) => server.listen(0, "127.0.0.1", () => done()));
+    try {
+      const port = (server.address() as AddressInfo).port;
+      // A local upstream cannot pass loadConfig, so the config is built directly for this test.
+      const app = createApp({ config: agyConfig({ upstreamBaseUrl: `http://127.0.0.1:${port}` }), askJev: fakeJev({}).askJev });
+      const response = await app.request(GENERATE, {
+        method: "POST",
+        headers: { "content-type": "application/json", authorization: `Bearer ${TOKEN}` },
+        body: JSON.stringify(agyBody()),
+      });
+      expect(response.status).toBe(200);
+      expect(response.headers.get("content-encoding")).toBeNull();
+      expect(await response.json()).toEqual(payload);
+    } finally {
+      await new Promise((done) => server.close(done));
+    }
+  });
