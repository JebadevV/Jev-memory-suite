diff --git a/test/codeassist-multiturn.test.ts b/test/codeassist-multiturn.test.ts
new file mode 100644
index 0000000..fd36f21
--- /dev/null
+++ b/test/codeassist-multiturn.test.ts
@@ -0,0 +1,390 @@
+// Multi-turn Code Assist (agy) traffic: functionCall, functionResponse and thoughtSignature.
+// Everything runs offline. The upstream is a fake fetch, and askJev throws if anything asks it.
+//
+// The turn rules are quoted from Google's thought-signature documentation, read 2026-10-24:
+// https://docs.cloud.google.com/vertex-ai/generative-ai/docs/thought-signatures
+//  - parallel calls: "only the first functionCall part will contain the thought_signature"
+//  - sequential calls: "each functionCall part will contain a thought_signature"
+//  - "Interleaving responses (FC1+signature, FR1, FC2, FR2) results in a 400 error"
+//  - "If a required thought signature is not returned when using Gemini 3 models, the model will return a 400 error"
+//  - "A turn begins with the most recent user message that is not a functionResponse"
+//  - skip_thought_signature_validator: "a last resort as it will negatively impact model performance"
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../src/app.js";
+import { codeAssistAdapter, type CodeAssistRequest } from "../src/adapters/codeassist.js";
+import { type GeminiContent, type GeminiPart, type GeminiRequest, geminiAdapter } from "../src/adapters/gemini.js";
+import type { AskJev } from "../src/decide.js";
+import type { RouterInput } from "../src/types.js";
+import { testConfig } from "./helpers.js";
+
+const CA = "https://daily-cloudcode-pa.googleapis.com";
+const TOKEN = "ya29.test-token-multiturn";
+const SKIP = "skip_thought_signature_validator";
+const RULES_URL = "https://docs.cloud.google.com/vertex-ai/generative-ai/docs/thought-signatures";
+const FIXTURES = new URL("./fixtures/codeassist/", import.meta.url);
+
+interface Candidate {
+  content: { role: string; parts: GeminiPart[] };
+  finishReason?: string;
+  index?: number;
+}
+
+interface Reply {
+  response: { candidates: Candidate[]; usageMetadata?: Record<string, number>; modelVersion?: string; responseId?: string };
+  traceId?: string;
+  metadata?: unknown;
+}
+
+interface Fixture {
+  description: string;
+  rules: string;
+  request: CodeAssistRequest;
+  replySse: Reply[];
+  replyJson: Reply;
+}
+
+/** The raw text is what the gateway must send upstream byte for byte; the parsed form is what the tests read. */
+function loadFixture(name: string): { raw: string; fixture: Fixture } {
+  const raw = readFileSync(new URL(name, FIXTURES), "utf8");
+  return { raw, fixture: JSON.parse(raw) as Fixture };
+}
+
+const requestOf = (fixture: Fixture): GeminiRequest => fixture.request.request ?? {};
+const contentsOf = (fixture: Fixture): GeminiContent[] => requestOf(fixture).contents ?? [];
+
+/** The wire form of an SSE reply: one `data:` line per event, each followed by a blank line. */
+const sseText = (events: Reply[]) => events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join("");
+
+const sig = (part: GeminiPart): string | undefined => (typeof part.thoughtSignature === "string" ? part.thoughtSignature : undefined);
+
+/** Every signature in a list of contents, with where it sits: content index, part index, value. */
+const signatures = (contents: GeminiContent[]) =>
+  contents.flatMap((content, i) =>
+    (content.parts ?? []).flatMap((part, j) => {
+      const value = sig(part);
+      return value === undefined ? [] : [{ i, j, value }];
+    }),
+  );
+
+const isResponseOnly = (content: GeminiContent) => {
+  const parts = content.parts ?? [];
+  return parts.length > 0 && parts.every((part) => part.functionResponse !== undefined);
+};
+
+/** Index of the first content of the current turn: the most recent user message that is not a functionResponse. */
+export function turnStart(contents: GeminiContent[]): number {
+  for (let i = contents.length - 1; i >= 0; i--) {
+    const content = contents[i]!;
+    if (content.role === "user" && !isResponseOnly(content)) return i;
+  }
+  return -1;
+}
+
+/**
+ * The rules that make the API answer 400 when they are broken, checked over the current turn only:
+ * the first functionCall of every model message carries its signature, and each functionCall is
+ * answered by a functionResponse in the very next message, all of them together in that message.
+ * Earlier turns and text-only replies are not checked, because the documentation makes their
+ * signatures optional.
+ */
+export function turnViolations(contents: GeminiContent[]): string[] {
+  const problems: string[] = [];
+  const start = turnStart(contents);
+  if (start < 0) return problems;
+  for (let i = start + 1; i < contents.length; i++) {
+    const content = contents[i]!;
+    if (content.role !== "model") continue;
+    const calls = (content.parts ?? []).filter((part) => part.functionCall !== undefined);
+    if (calls.length === 0) continue;
+    const names = calls.map((part) => part.functionCall!.name);
+    if (sig(calls[0]!) === undefined) problems.push(`content ${i}: functionCall ${names[0]} has no thoughtSignature`);
+    const next = contents[i + 1];
+    const answered = next?.role === "user" ? (next.parts ?? []).flatMap((part) => (part.functionResponse ? [part.functionResponse.name] : [])) : [];
+    for (const name of names) {
+      const at = answered.indexOf(name);
+      if (at < 0) problems.push(`content ${i}: no functionResponse for ${name} in the next user message`);
+      else answered.splice(at, 1);
+    }
+  }
+  return problems;
+}
+
+/** A stand-in for the upstream and for askJev: askJev counts its calls and always refuses. */
+function gateway(reply: (url: string) => Response) {
+  const calls: { url: string; headers: Headers; text: string }[] = [];
+  const logged: Record<string, unknown>[] = [];
+  let asked = 0;
+  const askJev: AskJev = async () => {
+    asked++;
+    throw new Error("askJev must not run in the agy passthrough");
+  };
+  const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const text = init?.body === undefined || init.body === null ? "" : await new Response(init.body as BodyInit).text();
+    calls.push({ url: String(input), headers: new Headers(init?.headers), text });
+    return reply(String(input));
+  }) as typeof fetch;
+  const app = createApp({
+    // Routing and shadow are on in the config on purpose: the adapter must still refuse to ask Jev.
+    config: testConfig({ codeAssist: true, routing: true, shadow: true, upstreamBaseUrl: CA }),
+    askJev,
+    fetch: fetchImpl,
+    log: (entry) => logged.push(entry),
+  });
+  const post = (path: string, body: string) =>
+    app.request(path, {
+      method: "POST",
+      headers: { "content-type": "application/json", authorization: `Bearer ${TOKEN}` },
+      body,
+    });
+  return { post, calls, logged, asked: () => asked };
+}
+
+/** Log lines are written once the reply has been read to the end, in the background: wait for them. */
+async function until(check: () => boolean) {
+  for (let i = 0; i < 200 && !check(); i++) await new Promise((done) => setTimeout(done, 5));
+}
+
+const REQUEST_FIXTURES = [
+  { file: "sequential-turn.json", signatures: 2 },
+  { file: "parallel-calls.json", signatures: 1 },
+  { file: "streamed-signature.json", signatures: 0 },
+  { file: "completed-history.json", signatures: 1 },
+] as const;
+
+const ENDPOINTS = [
+  { name: "streamGenerateContent?alt=sse", path: "/v1internal:streamGenerateContent?alt=sse", stream: true },
+  { name: "generateContent", path: "/v1internal:generateContent", stream: false },
+] as const;
+
+describe("agy multi-turn: fixtures", () => {
+  it("each request fixture carries the signatures its rules talk about", () => {
+    for (const { file, signatures: expected } of REQUEST_FIXTURES) {
+      const { fixture } = loadFixture(file);
+      expect(fixture.rules).toBe(RULES_URL);
+      expect(signatures(contentsOf(fixture)), file).toHaveLength(expected);
+    }
+  });
+
+  it("the sequential fixture is the request sent after two steps, ending in a functionResponse", () => {
+    const { fixture } = loadFixture("sequential-turn.json");
+    const contents = contentsOf(fixture);
+    expect(contents.map((content) => content.role)).toEqual(["user", "model", "user", "model", "user"]);
+    expect(signatures(contents).map((s) => s.value)).toEqual(["ZmFrZS1zaWctc2VxLUE=", "ZmFrZS1zaWctc2VxLUI="]);
+    // The turn did not restart at the functionResponse: it still starts at the first user text.
+    expect(turnStart(contents)).toBe(0);
+  });
+
+  it("the parallel fixture signs only the first functionCall, and answers both in one message", () => {
+    const { fixture } = loadFixture("parallel-calls.json");
+    const contents = contentsOf(fixture);
+    const [, model, answer] = contents;
+    expect(model!.parts!.map((part) => part.functionCall?.name)).toEqual(["read_file", "read_file"]);
+    expect(sig(model!.parts![0]!)).toBeDefined();
+    expect(sig(model!.parts![1]!)).toBeUndefined();
+    expect(answer!.parts!.filter((part) => part.functionResponse)).toHaveLength(2);
+  });
+
+  it("the streamed fixture puts the signature in an empty-text part, in the last event before finishReason", () => {
+    const { fixture } = loadFixture("streamed-signature.json");
+    const events = fixture.replySse;
+    expect(events).toHaveLength(3);
+    const [, middle, last] = events;
+    expect(middle!.response.candidates[0]!.content.parts).toEqual([{ text: "", thoughtSignature: "ZmFrZS1zaWctc3RyZWFt" }]);
+    expect(last!.response.candidates[0]!.finishReason).toBe("STOP");
+  });
+
+  it("the completed-history fixture closes its earlier turn with a signature on the last text part", () => {
+    const { fixture } = loadFixture("completed-history.json");
+    const contents = contentsOf(fixture);
+    const earlier = contents[1]!.parts!;
+    expect(earlier.at(-1)!.text).toBe("There are 3 files: a.ts, b.ts, c.ts.");
+    expect(sig(earlier.at(-1)!)).toBe("ZmFrZS1zaWctaGlzdC1wcmV2");
+    expect(turnStart(contents)).toBe(2);
+  });
+});
+
+describe("agy multi-turn: passthrough, the gateway in agy mode", () => {
+  for (const { file } of REQUEST_FIXTURES) {
+    for (const endpoint of ENDPOINTS) {
+      it(`${file} through ${endpoint.name}: body and reply byte for byte, usage logged, askJev never called`, async () => {
+        const { raw, fixture } = loadFixture(file);
+        const reply = endpoint.stream ? sseText(fixture.replySse) : JSON.stringify(fixture.replyJson);
+        const { post, calls, logged, asked } = gateway(() =>
+          new Response(reply, { headers: { "content-type": endpoint.stream ? "text/event-stream" : "application/json" } }),
+        );
+
+        const response = await post(endpoint.path, raw);
+
+        expect(response.status).toBe(200);
+        expect(await response.text()).toBe(reply);
+        expect(calls).toHaveLength(1);
+        expect(calls[0]!.url).toBe(`${CA}${endpoint.path}`);
+        expect(calls[0]!.text).toBe(raw);
+        expect(calls[0]!.headers.get("authorization")).toBe(`Bearer ${TOKEN}`);
+        expect(asked()).toBe(0);
+
+        await until(() => logged.some((entry) => entry.event === "route" && "usage" in entry));
+        const usage = (endpoint.stream ? fixture.replySse.at(-1)! : fixture.replyJson).response.usageMetadata!;
+        expect(logged.find((entry) => entry.event === "route")).toMatchObject({
+          status: 200,
+          mode: "passthrough",
+          reason: "codeassist_passthrough_only",
+          // Gemini bills thoughts as output: candidates plus thoughts.
+          usage: { input: usage.promptTokenCount, output: usage.candidatesTokenCount! + usage.thoughtsTokenCount! },
+        });
+      });
+    }
+  }
+
+  it("reads every part of a streamed reply up to finishReason; a reader that skips empty text misses the signature", () => {
+    const { fixture } = loadFixture("streamed-signature.json");
+    const text = sseText(fixture.replySse);
+    const events = text.split("\n\n").filter((block) => block.length > 0);
+    expect(events).toHaveLength(3);
+
+    const parts = events.flatMap((block, event) => {
+      const candidate = (JSON.parse(block.replace(/^data: /, "")) as Reply).response.candidates[0]!;
+      return candidate.content.parts.map((part) => ({ event, part, finished: candidate.finishReason !== undefined }));
+    });
+    const found = parts.filter(({ part }) => sig(part) !== undefined);
+    expect(found.map(({ event }) => event)).toEqual([1]);
+    expect(parts.find(({ part }) => sig(part))!.part.text).toBe("");
+
+    // toInput-style reading: parts with no text are dropped before the signature is seen.
+    expect(parts.filter(({ part }) => part.text).some(({ part }) => sig(part) !== undefined)).toBe(false);
+  });
+});
+
+describe("agy multi-turn: the turn rules", () => {
+  for (const { file } of REQUEST_FIXTURES) {
+    it(`${file} obeys the rules for its current turn`, () => {
+      expect(turnViolations(contentsOf(loadFixture(file).fixture))).toEqual([]);
+    });
+  }
+
+  const sequential = () => structuredClone(contentsOf(loadFixture("sequential-turn.json").fixture));
+  const parallel = () => structuredClone(contentsOf(loadFixture("parallel-calls.json").fixture));
+
+  it("rejects a sequential step whose signature was dropped", () => {
+    const contents = sequential();
+    delete contents[3]!.parts![0]!.thoughtSignature;
+    expect(turnViolations(contents)).toEqual(["content 3: functionCall run_command has no thoughtSignature"]);
+  });
+
+  it("rejects a parallel group whose first call lost its signature", () => {
+    const contents = parallel();
+    delete contents[1]!.parts![0]!.thoughtSignature;
+    expect(turnViolations(contents)).toEqual(["content 1: functionCall read_file has no thoughtSignature"]);
+  });
+
+  it("rejects a parallel group whose responses are split across messages (FC1+signature, FR1, FC2, FR2)", () => {
+    const contents = parallel();
+    // Keep the two calls in one model message, but answer the second one in a message of its own.
+    const answers = contents[2]!.parts!;
+    contents.splice(2, 1, { role: "user", parts: [answers[0]!] }, { role: "user", parts: [answers[1]!] });
+    expect(turnViolations(contents)).toEqual(["content 1: no functionResponse for read_file in the next user message"]);
+  });
+
+  it("does not require a signature in a closed earlier turn", () => {
+    const contents: GeminiContent[] = [
+      { role: "user", parts: [{ text: "List the files." }] },
+      { role: "model", parts: [{ functionCall: { name: "read_file", args: { path: "a.ts" } } }] },
+      { role: "user", parts: [{ functionResponse: { name: "read_file", response: { content: "x" } } }] },
+      { role: "model", parts: [{ text: "Done." }] },
+      { role: "user", parts: [{ text: "Now edit it." }] },
+    ];
+    expect(turnStart(contents)).toBe(4);
+    expect(turnViolations(contents)).toEqual([]);
+  });
+});
+
+describe("agy multi-turn: routing that stays off (adapter calls with simulated decisions)", () => {
+  const decisions: Record<"forced" | "none", Parameters<typeof codeAssistAdapter.apply>[1]> = {
+    forced: { mode: "forced", tool: "read_file", kind: "function", confidence: 0.9 },
+    none: { mode: "none", confidence: 0.9 },
+  };
+  const expectedToolConfig = {
+    forced: { functionCallingConfig: { mode: "ANY", allowedFunctionNames: ["read_file"] } },
+    none: { functionCallingConfig: { mode: "NONE" } },
+  };
+
+  for (const file of ["sequential-turn.json", "parallel-calls.json", "completed-history.json"]) {
+    for (const mode of ["forced", "none"] as const) {
+      it(`apply(${mode}) on ${file}: contents and every signature stay, only toolConfig changes`, () => {
+        const { fixture } = loadFixture(file);
+        const original = structuredClone(fixture.request);
+        const rewritten = codeAssistAdapter.apply(fixture.request, decisions[mode]);
+
+        // The rewrite does not touch the original, which the gateway would otherwise replay.
+        expect(fixture.request).toEqual(original);
+        expect(rewritten.request!.contents).toEqual(original.request!.contents);
+        expect(signatures(rewritten.request!.contents!)).toEqual(signatures(original.request!.contents!));
+        expect(rewritten.request!.toolConfig).toEqual(expectedToolConfig[mode]);
+
+        const { toolConfig: _newConfig, ...newRequest } = rewritten.request!;
+        const { toolConfig: _oldConfig, ...oldRequest } = original.request!;
+        expect(newRequest).toEqual(oldRequest);
+        const { request: _newBody, ...newEnvelope } = rewritten;
+        const { request: _oldBody, ...oldEnvelope } = original;
+        expect(newEnvelope).toEqual(oldEnvelope);
+
+        // Undocumented: whether Google accepts a changed toolConfig in the middle of a turn that
+        // carries signatures. The rules say nothing about it, so this is only a structural check.
+        expect(turnViolations(rewritten.request!.contents!)).toEqual(turnViolations(original.request!.contents!));
+      });
+    }
+  }
+
+  it("directJson's functionCall has no thoughtSignature, and replaying it breaks the rule on the next step", () => {
+    const { fixture } = loadFixture("completed-history.json");
+    const json = codeAssistAdapter.directJson(fixture.request, { tool: "read_file", args: { path: "a.ts" }, inputTokens: 5 }) as Reply;
+    const part = json.response.candidates[0]!.content.parts[0]!;
+    expect(part.functionCall).toEqual({ name: "read_file", args: { path: "a.ts" } });
+    expect(sig(part)).toBeUndefined();
+
+    // The client appends the model's reply and answers it: the current turn now has an unsigned call.
+    const replay: GeminiContent[] = [
+      ...contentsOf(fixture),
+      { role: "model", parts: [part] },
+      { role: "user", parts: [{ functionResponse: { name: "read_file", response: { content: "x" } } }] },
+    ];
+    expect(turnViolations(replay)).toEqual(["content 3: functionCall read_file has no thoughtSignature"]);
+
+    // The only way out the documentation offers is the synthetic validator value, a last resort.
+    const withSkip = structuredClone(replay);
+    withSkip[3]!.parts![0]!.thoughtSignature = SKIP;
+    expect(turnViolations(withSkip)).toEqual([]);
+  });
+
+  it("directStream's SSE has no thoughtSignature either", () => {
+    const { fixture } = loadFixture("completed-history.json");
+    const call = { tool: "read_file", args: { path: "a.ts" }, inputTokens: 5 };
+    const text = codeAssistAdapter.directStream(fixture.request, call, new URL(`http://x${ENDPOINTS[0].path}`));
+    expect(typeof text).toBe("string");
+    expect(text as string).not.toContain("thoughtSignature");
+  });
+
+  it("toInput of the Gemini adapter would send the whole conversation to Jev: system, text, arguments and results", () => {
+    const { fixture } = loadFixture("sequential-turn.json");
+    const inner: GeminiRequest = { ...requestOf(fixture), model: fixture.request.model as string | undefined };
+    const input = geminiAdapter.toInput(inner, 100_000) as RouterInput;
+    const sent = JSON.stringify(input);
+
+    expect(input.system).toContain("You are a coding agent.");
+    expect(sent).toContain("Find the build error and fix it.");
+    expect(sent).toContain("src/build.ts");
+    expect(sent).toContain("export const build = () => 1;");
+    expect(sent).toContain("FAIL build.test.ts");
+    // The signatures themselves are dropped on the way to Jev.
+    expect(sent).not.toContain("ZmFrZS1zaWc");
+  });
+
+  it("a thought-summary part ({thought: true}) would reach Jev too, because toInput reads every text part", () => {
