diff --git a/test/isolate-home.setup.ts b/test/isolate-home.setup.ts
new file mode 100644
index 0000000..684dfe6
--- /dev/null
+++ b/test/isolate-home.setup.ts
@@ -0,0 +1,39 @@
+// vitest setupFiles: runs before each test file. On Windows os.homedir() reads USERPROFILE (not HOME),
+// so every variable that can move the home directory points at a fresh temporary directory, and the
+// run refuses to continue if os.homedir() still resolves to the real user home.
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { homedir, tmpdir } from "node:os";
+import { join, parse, resolve } from "node:path";
+import { afterAll } from "vitest";
+
+const fingerprint = (path: string) => createHash("sha256").update(resolve(path).toLowerCase()).digest("hex");
+
+// The real home is identified by a fingerprint, so no user path is written into the repository. A wrapper
+// that isolates the run first passes its own fingerprint in JEV_REAL_HOME_SHA256; otherwise the value
+// captured here, before anything is overridden, is the real home.
+const realHomeFingerprint = process.env.JEV_REAL_HOME_SHA256 ?? fingerprint(homedir());
+
+const home = mkdtempSync(join(tmpdir(), "jev-test-home-"));
+const appData = join(home, "AppData", "Roaming");
+mkdirSync(appData, { recursive: true });
+const { root } = parse(home);
+
+Object.assign(process.env, {
+  HOME: home,
+  USERPROFILE: home,
+  APPDATA: appData,
+  ...(process.platform === "win32" ? { HOMEDRIVE: root.replace(/[\\/]+$/, ""), HOMEPATH: home.slice(root.length - 1) } : {}),
+});
+
+if (resolve(homedir()) !== resolve(home) || fingerprint(homedir()) === realHomeFingerprint) {
+  throw new Error("test isolation failed: os.homedir() does not point at the temporary test home; refusing to run");
+}
+
+afterAll(() => {
+  try {
+    rmSync(home, { recursive: true, force: true });
+  } catch {
+    // A leftover temporary directory is harmless; the run's result does not depend on it.
+  }
+});
