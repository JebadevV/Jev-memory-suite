+import { codeAssistMethod } from "../codeassist.js";
+import type { DirectCall } from "../types.js";
+import { type Adapter, sse } from "./adapter.js";
+import { type GeminiRequest, geminiAdapter } from "./gemini.js";
+
+/** agy's generation body: the Gemini request sits under `request`, the model beside it. */
+export interface CodeAssistRequest {
+  model?: string;
+  stream?: boolean;
+  request?: GeminiRequest;
+  [key: string]: unknown;
+}
+
+/** The Gemini request the shared Gemini code reads, with the model the envelope names. */
+const inner = (req: CodeAssistRequest): GeminiRequest => {
+  const body = req.request && typeof req.request === "object" ? req.request : {};
+  return { ...body, model: req.model };
+};
+
+// Routing is switched off until the privacy review approves it: every request is skipped before
+// Jev is asked, so the conversation never leaves for Jev. The Gemini code below is kept whole, so
+// approving routing later only means changing toInput.
+function toInput(): { skip: string } {
+  return { skip: "codeassist_passthrough_only" };
+}
+
+function apply(req: CodeAssistRequest, decision: Parameters<Adapter<CodeAssistRequest>["apply"]>[1], argsModel?: string): CodeAssistRequest {
+  // model and stream live in the envelope, not in the Gemini request agy sent.
+  const { model: _model, stream: _stream, ...rewritten } = geminiAdapter.apply(inner(req), decision, argsModel);
+  return { ...req, request: rewritten };
+}
+
+function directJson(req: CodeAssistRequest, call: DirectCall): object {
+  return { response: geminiAdapter.directJson(inner(req), call) };
+}
+
+/** Code Assist streams SSE only with `?alt=sse`; without it, the reply is a JSON array of chunks. */
+function directStream(req: CodeAssistRequest, call: DirectCall, url: URL) {
+  const chunk = JSON.stringify(directJson(req, call));
+  return url.searchParams.get("alt") === "sse" ? sse([{ data: chunk }]) : { body: `[${chunk}]`, contentType: "application/json" };
+}
+
+/** The method is in the path, and streaming is chosen by it. */
+function fromUrl(url: URL) {
+  return { stream: codeAssistMethod(url.pathname) === "streamGenerateContent" };
+}
+
+/** Count tools as Gemini does; the model comes from the envelope. */
+function metadata(req: CodeAssistRequest | undefined, url: URL) {
+  return { ...geminiAdapter.metadata?.(req && inner(req), url), model: req?.model };
+}
+
+export const codeAssistAdapter: Adapter<CodeAssistRequest> = {
+  toInput,
+  apply,
+  directJson,
+  directStream,
+  fromUrl,
+  metadata,
+};
