+  it("ends the stream quietly when the client hangs up mid-SSE, and aborts the upstream read", async () => {
+    let upstreamSignal: AbortSignal | undefined;
+    const { app, upstream } = (() => {
+      const calls: { init: RequestInit }[] = [];
+      const fetchImpl = (async (_input: RequestInfo | URL, init?: RequestInit) => {
+        calls.push({ init: init ?? {} });
+        upstreamSignal = init?.signal ?? undefined;
+        const body = new ReadableStream<Uint8Array>({
+          start(controller) {
+            controller.enqueue(new TextEncoder().encode(frame({ response: { candidates: [] } })));
+            // Like a real fetch body: an abort errors the read instead of leaving it waiting.
+            upstreamSignal?.addEventListener("abort", () => controller.error(new DOMException("aborted", "AbortError")));
+          },
+        });
+        return new Response(body, { headers: { "content-type": "text/event-stream" } });
+      }) as typeof fetch;
+      const app = createApp({ config: agyConfig(), askJev: fakeJev({}).askJev, fetch: fetchImpl });
+      return { app, upstream: calls };
+    })();
+
+    const client = new AbortController();
+    const response = await app.request(STREAM, {
+      method: "POST",
+      headers: { "content-type": "application/json", authorization: `Bearer ${TOKEN}` },
+      body: JSON.stringify(agyBody()),
+      signal: client.signal,
+    });
+    const reader = response.body!.getReader();
+    expect((await reader.read()).done).toBe(false);
+
+    client.abort();
+    // Ends without throwing: the hang-up is the client's choice, not an error.
+    const after = await reader.read();
+    expect(after.done).toBe(true);
+    expect(upstream).toHaveLength(1);
+    expect(upstreamSignal?.aborted).toBe(true);
+  });
+});
