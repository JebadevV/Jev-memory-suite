+/** A fetch stand-in that records each call (body read as text) and answers with `respond`. */
+function recordingFetch(respond: (url: string, init: RequestInit) => Response | Promise<Response>) {
+  const calls: { url: string; init: RequestInit; headers: Headers; text: string }[] = [];
+  const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const text = init?.body === undefined || init.body === null ? "" : await new Response(init.body as BodyInit).text();
+    calls.push({ url: String(input), init: init ?? {}, headers: new Headers(init?.headers), text });
+    return respond(String(input), init ?? {});
+  }) as typeof fetch;
+  return { fetchImpl, calls };
+}
