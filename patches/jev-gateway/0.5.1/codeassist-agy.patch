diff --git a/src/codeassist.ts b/src/codeassist.ts
new file mode 100644
index 0000000..65cbe43
--- /dev/null
+++ b/src/codeassist.ts
@@ -0,0 +1,180 @@
+// Code Assist is the API behind Google's Antigravity CLI (`agy`). Its wire format is not public:
+// the routes below are what agy 1.4.7 calls, read from the `google.api.http` rules in its protobuf
+// descriptors (verified 2026-10-24). Anything not listed here is refused, never forwarded.
+
+/**
+ * Version of this Code Assist contract (the agy patch). /health reports it as `codeAssist`, so a
+ * launcher or a person can tell which contract a running gateway speaks.
+ */
+export const CODE_ASSIST_PATCH_VERSION = 2;
+
+/** The only hosts the gateway sends Code Assist traffic to. */
+export const CODE_ASSIST_HOSTS = ["cloudcode-pa.googleapis.com", "daily-cloudcode-pa.googleapis.com"];
+
+/** The longest query string a Code Assist request may carry; longer ones get 414 before upstream. */
+export const CODE_ASSIST_MAX_QUERY = 4096;
+
+type Verb = "GET" | "POST";
+
+export interface CodeAssistRoute {
+  verb: Verb;
+  kind: "generate" | "auxiliary";
+  /** The name the route is known by in logs and tests. */
+  name: string;
+}
+
+const colon = (verb: Verb, kind: CodeAssistRoute["kind"], names: readonly string[]): [string, CodeAssistRoute][] =>
+  names.map((name) => [`/v1internal:${name}`, { verb, kind, name }]);
+
+const exact = (verb: Verb, kind: CodeAssistRoute["kind"], paths: readonly string[]): [string, CodeAssistRoute][] =>
+  paths.map((path) => [path, { verb, kind, name: path }]);
+
+/**
+ * Every exact pathname agy uses. Matching is by equality on the raw pathname, never by prefix.
+ * The one template is `/v1internal/agentPlugins/<id>`, handled in `lookup`.
+ */
+export const CODE_ASSIST_ROUTES: ReadonlyMap<string, CodeAssistRoute> = new Map<string, CodeAssistRoute>([
+  // POST colon: generation, routed through the adapter.
+  ...colon("POST", "generate", ["generateContent", "streamGenerateContent"]),
+  // POST colon: account, quota and setup calls, forwarded untouched.
+  ...colon("POST", "auxiliary", [
+    "battleModeAutoTrigger",
+    "battleModeOverrides",
+    "checkUrlAntivirus",
+    "checkUrlDenylist",
+    "completeCode",
+    "connectInstance",
+    "connectInstanceV2",
+    "countTokens",
+    "deleteInstance",
+    "fetchAdminControls",
+    "fetchAvailableModels",
+    "fetchCodeCustomizationState",
+    "fetchFromTrawlerCache",
+    "fetchUserInfo",
+    "generateChat",
+    "generateCode",
+    "getBundleWriteMint",
+    "initiateMeshSession",
+    "internalAtomicAgenticChat",
+    "listAuthorizedDevices",
+    "listExperiments",
+    "listModelConfigs",
+    "loadCodeAssist",
+    "migrateDatabaseCode",
+    "notifyUser",
+    "onboardUser",
+    "onboardUserBackgroundTasks",
+    "pollSignalingMessages",
+    "provisionConversationBundleDir",
+    "proxyCommand",
+    "recordClientEvent",
+    "recordCodeAssistMetrics",
+    "recordSmartchoicesFeedback",
+    "recordTrajectoryAnalytics",
+    "registerInteraction",
+    "registerWebPush",
+    "retrieveUserQuota",
+    "retrieveUserQuotaSummary",
+    "revokeAuthorizedDevice",
+    "rewriteUri",
+    "searchSnippets",
+    "sendSignalingMessage",
+    "setCodeAssistGlobalUserSetting",
+    "setUserSettings",
+    "streamGenerateChat",
+    "streamProxyCommand",
+    "tabChat",
+    "transformCode",
+    "updateInstance",
+    "uploadPerformanceProfile",
+    "writeTrajectoryAcls",
+  ]),
+  // GET colon: read-only account calls.
+  ...colon("GET", "auxiliary", [
+    "getCodeAssistGlobalUserSetting",
+    "listAgents",
+    "listCloudAICompanionProjects",
+    "listInstances",
+    "listRemoteRepositories",
+  ]),
+  // GET slash: exact paths only.
+  ...exact("GET", "auxiliary", [
+    "/v1internal/agentPlugins",
+    "/v1internal/buildWithGooglePlugins",
+    "/v1internal/cascadeNuxes",
+    "/v1internal/webDocsOptions",
+    "/v1internal/health",
+  ]),
+]);
+
+/** `/v1internal/agentPlugins/<id>`: one segment, and the id must be a plain name, not a path part. */
+const AGENT_PLUGIN_PREFIX = "/v1internal/agentPlugins/";
+const AGENT_PLUGIN_ID = /^[A-Za-z0-9._~-]{1,128}$/;
+
+function lookup(pathname: string): CodeAssistRoute | undefined {
+  const known = CODE_ASSIST_ROUTES.get(pathname);
+  if (known) return known;
+  if (!pathname.startsWith(AGENT_PLUGIN_PREFIX)) return undefined;
+  const id = pathname.slice(AGENT_PLUGIN_PREFIX.length);
+  if (!AGENT_PLUGIN_ID.test(id) || id === "." || id === "..") return undefined;
+  return { verb: "GET", kind: "auxiliary", name: "/v1internal/agentPlugins/*" };
+}
+
+export type CodeAssistRouteMatch =
+  | { kind: "generate" | "auxiliary"; name: string }
+  | { kind: "method_not_allowed"; name: string; allow: string };
+
+/**
+ * Classifies one request by its raw pathname (the one `forward` sends upstream, percent-encoding
+ * and all). Undefined means the path is not a Code Assist route and must not reach upstream.
+ * A known path with the wrong verb is `method_not_allowed`, HEAD and OPTIONS included.
+ */
+export function codeAssistRoute(method: string, pathname: string): CodeAssistRouteMatch | undefined {
+  const route = lookup(pathname);
+  if (!route) return undefined;
+  if (method === route.verb) return { kind: route.kind, name: route.name };
+  return { kind: "method_not_allowed", name: route.name, allow: route.verb };
+}
+
+/**
+ * The pathname as it may appear in a log line: the method's name, or the first segment after
+ * `/v1internal/`, with only `[A-Za-z0-9_]` kept and at most 64 characters. Never the rest of the
+ * path, never the query, because a request may carry a prompt.
+ */
+export function codeAssistLogPath(pathname: string): string {
+  const clean = (part: string) => part.replace(/[^A-Za-z0-9_]/g, "").slice(0, 64);
+  const colonName = /^\/v1internal:([^/?#]*)/.exec(pathname);
+  if (colonName) return `/v1internal:${clean(colonName[1]!)}`;
+  const segment = /^\/v1internal\/([^/?#]*)/.exec(pathname);
+  if (segment) return `/v1internal/${clean(segment[1]!)}`;
+  return "/v1internal";
+}
+
+/** The method a `/v1internal:<method>` path names, or undefined for any other path. */
+export function codeAssistMethod(path: string): string | undefined {
+  return /^\/v1internal:([A-Za-z]+)$/.exec(path)?.[1];
+}
+
+/**
+ * True only for an https origin on a Code Assist host, with no credentials, no path beyond the
+ * root, and no query or fragment. The gateway forwards the user's Google token to whatever this
+ * accepts, so anything looser would send it elsewhere.
+ */
+export function isCodeAssistUpstream(base: string): boolean {
+  try {
+    const url = new URL(base);
+    return (
+      url.protocol === "https:" &&
+      (url.port === "" || url.port === "443") &&
+      CODE_ASSIST_HOSTS.includes(url.hostname) &&
+      url.username === "" &&
+      url.password === "" &&
+      (url.pathname === "" || url.pathname === "/") &&
+      url.search === "" &&
+      url.hash === ""
+    );
+  } catch {
+    return false;
+  }
+}
